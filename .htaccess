# North Mountain Media — Apache root configuration

DirectoryIndex index.php

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # During a rollback-protected managed update, keep the health probe
    # reachable while routing normal browser traffic to a temporary 503 page.
    RewriteCond %{DOCUMENT_ROOT}/storage/vp3-updates/maintenance.flag -f
    RewriteCond %{REQUEST_URI} !/api/vp3-update/health\.php$ [NC]
    RewriteCond %{REQUEST_URI} !/vp3-update-maintenance\.php$ [NC]
    RewriteRule ^ vp3-update-maintenance.php [L]

    # Redirect legacy HTML entry points to the PHP application.
    RewriteCond %{THE_REQUEST} \s/+index\.html?(?:[\s?]|$) [NC]
    RewriteRule ^index\.html?$ index.php [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+index-preview\.html?(?:[\s?]|$) [NC]
    RewriteRule ^index-preview\.html?$ index-preview.php [R=301,L]

    # POD Protocol 1 public identity discovery.
    RewriteRule ^\.well-known/pod\.json$ pod-discovery.php [L,NC]
</IfModule>

# Preserve bearer authorization when Apache/FastCGI provides it.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Allow same-origin microphone use on public and relationship-scoped call surfaces.
<IfModule mod_headers.c>
    <FilesMatch "^(index|index-preview|call-dave|connected-call|connected-receptionist|pod-call|admin|client)\.php$">
        Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
    </FilesMatch>
</IfModule>

# Prevent direct access to configuration and internal documentation.
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|config-example\.php|BUILD\.txt|PORTAL-README\.md|ADMIN-SETUP\.md|TRANSCRIPTION-SETUP\.md|COMMUNICATIONS-SETUP\.md|CALL-CENTER-SETUP\.md|VOICEMAIL-CRM-SETUP\.md|MEDIA-LIBRARY-CALL-SETUP\.md|KNOWLEDGE-LIBRARY-SETUP\.md|CALL-CENTER-SETTINGS-SETUP\.md|KNOWLEDGE-ENTRY-SETUP\.md|KNOWLEDGE-DETAIL-WIDTH-SETUP\.md|ADMIN-DATA-ASSISTANT-SETUP\.md|VOICE-CONTACT-TABS-SETUP\.md|CLEAN-CALL-INTERFACE-SETUP\.md|EMBEDDED-CALL-CARD-SETUP\.md|PUBLIC-SIDEBAR-SETUP\.md|VISITOR-SIDEBAR-SETUP\.md|ACCOUNT-PROFILE-SETUP\.md|PROJECT-LINKS-SETUP\.md|CRM-MESSAGE-SETUP\.md|PORTFOLIO-BACKEND-SETUP\.md|DASHBOARD-HISTORY-SETUP\.md|VISITOR-INTELLIGENCE-SETUP\.md|MUSIC-LIBRARY-SETUP\.md|PUBLISHING-SYSTEMS-SETUP\.md|PUBLISHING-WORKFLOW-SETUP\.md|EVENTS-CALENDAR-SETUP\.md|APPOINTMENTS-BOOKING-SETUP\.md|PROPOSALS-INTAKE-SETUP\.md|POD-IDENTITY-RELATIONSHIPS-SETUP-v63\.md|V63-SCORECARD\.md|V63-VALIDATION\.txt|POD-CONNECTED-CALLING-SETUP-v63\.1\.md|V63\.1-SCORECARD\.md|V63\.1-VALIDATION\.txt|POD-CONNECTED-MESSAGING-SETUP-v63\.2\.md|V63\.2-SCORECARD\.md|V63\.2-VALIDATION\.txt|POD-AGENT-RECEPTIONIST-SETUP-v63\.3\.md|V63\.3-SCORECARD\.md|V63\.3-VALIDATION\.txt|POD-AGENT-VOICE-RECEPTIONIST-SETUP-v63\.4\.md|V63\.4-SCORECARD\.md|V63\.4-VALIDATION\.txt|POD-HOMESERVER-VOICE-PROVIDER-CONTRACT-v63\.5\.md|POD-HOMESERVER-VOICE-PROVIDER-SETUP-v63\.5\.md|V63\.5-SCORECARD\.md|V63\.5-VALIDATION\.txt|VP3-POD-LICENSING-CONTRACT-v64\.md|VP3-POD-LICENSING-SETUP-v64\.md|V64-SCORECARD\.md|V64-VALIDATION\.txt|VP3-POD-MANAGED-UPDATE-CONTRACT-v65\.md|VP3-POD-MANAGED-UPDATE-SETUP-v65\.md|V65-SCORECARD\.md|V65-VALIDATION\.txt)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 compatibility fallback.
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config-example\.php|BUILD\.txt|PORTAL-README\.md|ADMIN-SETUP\.md|TRANSCRIPTION-SETUP\.md|COMMUNICATIONS-SETUP\.md|CALL-CENTER-SETUP\.md|VOICEMAIL-CRM-SETUP\.md|MEDIA-LIBRARY-CALL-SETUP\.md|KNOWLEDGE-LIBRARY-SETUP\.md|CALL-CENTER-SETTINGS-SETUP\.md|KNOWLEDGE-ENTRY-SETUP\.md|KNOWLEDGE-DETAIL-WIDTH-SETUP\.md|ADMIN-DATA-ASSISTANT-SETUP\.md|VOICE-CONTACT-TABS-SETUP\.md|CLEAN-CALL-INTERFACE-SETUP\.md|EMBEDDED-CALL-CARD-SETUP\.md|PUBLIC-SIDEBAR-SETUP\.md|VISITOR-SIDEBAR-SETUP\.md|ACCOUNT-PROFILE-SETUP\.md|PROJECT-LINKS-SETUP\.md|CRM-MESSAGE-SETUP\.md|PORTFOLIO-BACKEND-SETUP\.md|DASHBOARD-HISTORY-SETUP\.md|VISITOR-INTELLIGENCE-SETUP\.md|MUSIC-LIBRARY-SETUP\.md|PUBLISHING-SYSTEMS-SETUP\.md|PUBLISHING-WORKFLOW-SETUP\.md|EVENTS-CALENDAR-SETUP\.md|APPOINTMENTS-BOOKING-SETUP\.md|PROPOSALS-INTAKE-SETUP\.md|POD-IDENTITY-RELATIONSHIPS-SETUP-v63\.md|V63-SCORECARD\.md|V63-VALIDATION\.txt|POD-CONNECTED-CALLING-SETUP-v63\.1\.md|V63\.1-SCORECARD\.md|V63\.1-VALIDATION\.txt|POD-CONNECTED-MESSAGING-SETUP-v63\.2\.md|V63\.2-SCORECARD\.md|V63\.2-VALIDATION\.txt|POD-AGENT-RECEPTIONIST-SETUP-v63\.3\.md|V63\.3-SCORECARD\.md|V63\.3-VALIDATION\.txt|POD-AGENT-VOICE-RECEPTIONIST-SETUP-v63\.4\.md|V63\.4-SCORECARD\.md|V63\.4-VALIDATION\.txt|POD-HOMESERVER-VOICE-PROVIDER-CONTRACT-v63\.5\.md|POD-HOMESERVER-VOICE-PROVIDER-SETUP-v63\.5\.md|V63\.5-SCORECARD\.md|V63\.5-VALIDATION\.txt|VP3-POD-LICENSING-CONTRACT-v64\.md|VP3-POD-LICENSING-SETUP-v64\.md|V64-SCORECARD\.md|V64-VALIDATION\.txt|VP3-POD-MANAGED-UPDATE-CONTRACT-v65\.md|VP3-POD-MANAGED-UPDATE-SETUP-v65\.md|V65-SCORECARD\.md|V65-VALIDATION\.txt)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Public publishing, POD call, receptionist, feed, and editor cache controls.
<IfModule mod_headers.c>
    <FilesMatch "^(index|index-preview|music-library|music-collection|blog|blog-post|resume-post|events|event|event-registration|booking|appointment|intake|intake-confirmation|proposal|call-dave|pod-call|connected-call|connected-receptionist)\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "^(visitor-activity|music-player|music-dashboard|public-music-shell|publishing-workflow|events-calendar|bookings|proposals|pod-contacts-v63-1|pod-receptionist-v63-3|pod-receptionist-voice-v63-4)\.js$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>
    <FilesMatch "^(site-builder-bootstrap|site-builder|site-builder-advanced)\.js$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "^(blog-feed|sitemap|events-calendar|event-cover|pod-discovery)\.php$">
        Header set Cache-Control "public, max-age=900, must-revalidate"
    </FilesMatch>
</IfModule>

# v58 secure appointment management and calendar controls
<IfModule mod_headers.c>
    <FilesMatch "^(appointment-calendar)\.php$">
        Header set Cache-Control "no-store, private, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# v59 secure proposal output
<IfModule mod_headers.c>
    <FilesMatch "^(proposal-pdf)\.php$">
        Header set Cache-Control "no-store, private, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>